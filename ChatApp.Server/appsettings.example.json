{
  // 이 파일을 복사해 appsettings.json을 만들고 값을 수정하세요. (appsettings.json은 Git에 올라가지 않습니다)
  "Port": 9000,
  "ConnectionString": "Server=localhost;Port=3306;Database=chatapp;User ID=chatapp;Password=여기에_DB_비밀번호;",

  // 회원가입을 허용할 이메일 도메인. ["*"] = 제한 없음(네이버·지메일 등 모든 이메일 허용)
  // 사내 메일만 받으려면 예: [ "company.kr", "basiclike.kr" ]
  "AllowedEmailDomains": [ "*" ],

  "AutoApprove": true,
  "MaxLoginAttempts": 5,
  "LockMinutes": 10,

  // 파일·이미지·동영상 전송: 저장 폴더(서버 exe 폴더 기준)와 파일 1개 최대 크기(MB)
  "UploadFolder": "uploads",
  "MaxFileSizeMB": 3072,

  // TLS 암호화 통신. 인증서 파일이 없으면 서버가 처음 실행할 때 자체 서명 인증서를 만들고 지문을 출력합니다.
  // (클라이언트는 처음 접속할 때 그 지문을 보여 주고 확인을 받습니다)
  "Tls": {
    "Enabled": true,
    "CertificatePath": "certs/server.pfx",
    "CertificatePassword": ""
  }
}
