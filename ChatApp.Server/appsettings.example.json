{
  // 이 파일을 복사해 appsettings.json을 만들고 값을 수정하세요. (appsettings.json은 Git에 올라가지 않습니다)
  "Port": 9000,
  "ConnectionString": "Server=localhost;Port=3306;Database=chatapp;User ID=chatapp;Password=여기에_DB_비밀번호;",

  // 회원가입을 허용할 이메일 도메인 (회사 메일 도메인으로 바꾸세요).
  // ["*"] = 제한 없음(네이버·지메일 등 모든 이메일 허용) → 테스트·부하 테스트 때만 쓰세요.
  "AllowedEmailDomains": [ "company.kr" ],

  // false = 가입하면 관리자가 승인해야 쓸 수 있음(사내 메신저 권장). true = 가입 즉시 사용(테스트용)
  "AutoApprove": false,
  "MaxLoginAttempts": 5,
  "LockMinutes": 10,

  // 파일·이미지·동영상 전송: 저장 폴더(서버 exe 폴더 기준)와 파일 1개 최대 크기(MB)
  "UploadFolder": "uploads",
  "MaxFileSizeMB": 3072,

  // 서버 보호: 최대 연결 수, IP당 연결 수(같은 PC 127.0.0.1은 제외), 로그인 제한 시간(초)
  "MaxConnections": 2000,
  "MaxConnectionsPerIp": 50,
  "LoginTimeoutSeconds": 300,

  // 보관 기간(일). 지난 대화·파일·감사 로그는 하루 한 번 자동으로 지웁니다. 0 = 지우지 않음
  "MessageRetentionDays": 365,
  "FileRetentionDays": 180,
  "AuditRetentionDays": 730,

  // 클라이언트 업데이트 안내: 새 설치 파일을 배포한 뒤 버전과 위치를 적으면, 옛 버전 사용자에게 안내가 뜹니다.
  // 예) "ClientLatestVersion": "1.3.0", "ClientUpdateUrl": "\\\\fileserver\\share\\사내톡-설치.exe"
  "ClientLatestVersion": "",
  "ClientUpdateUrl": "",

  // TLS 암호화 통신. 인증서 파일이 없으면 서버가 처음 실행할 때 자체 서명 인증서를 만들고 지문을 출력합니다.
  // (클라이언트는 처음 접속할 때 그 지문을 보여 주고 확인을 받습니다)
  "Tls": {
    "Enabled": true,
    "CertificatePath": "certs/server.pfx",
    "CertificatePassword": ""
  },
  "Ldap": {
    "Enabled": false,
    "Server": "dc.company.kr",
    "Port": 636,
    "UserPrincipalNameSuffix": "company.kr",
    "TimeoutSeconds": 5,
    // Profile sync is optional. Use the directory's employee number attribute and a narrow OU base DN.
    "ProfileBaseDn": "OU=Employees,DC=company,DC=kr",
    "EmployeeNumberAttribute": "sAMAccountName",
    "DisplayNameAttribute": "displayName",
    "DepartmentAttribute": "department",
    "PositionAttribute": "title"
  }
}
