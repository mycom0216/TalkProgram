  "lines": [
    { "id": 1,  "conv": "room:dev", "sender": "김민수 팀장", "time": "2026-10-12T09:30:00", "text": "이번 릴리스 배포는 10월 29일 오후 10시로 확정했습니다." },
    { "id": 2,  "conv": "room:dev", "sender": "박지훈", "time": "2026-10-12T09:31:00", "text": "배포 전에 DB 백업 꼭 해주세요. 담당은 이서연님이죠?" },
    { "id": 3,  "conv": "room:dev", "sender": "이서연", "time": "2026-10-12T09:33:00", "text": "네, 제가 28일 저녁에 풀백업 받아두겠습니다." },
    { "id": 4,  "conv": "room:dev", "sender": "김민수 팀장", "time": "2026-10-12T09:40:00", "text": "롤백 기준은 에러율 2% 넘으면 바로 롤백입니다." },
    { "id": 5,  "conv": "room:dev", "sender": "박지훈", "time": "2026-10-12T14:10:00", "text": "로그인 API 응답이 느립니다. 평균 1.8초 나와요." },
    { "id": 6,  "conv": "room:dev", "sender": "이서연", "time": "2026-10-12T14:15:00", "text": "비밀번호 해시 반복 횟수를 60만 회로 올린 영향입니다. 메시지 전달에는 영향 없고 로그인만 느려져요." },
    { "id": 7,  "conv": "room:dev", "sender": "김민수 팀장", "time": "2026-10-12T14:20:00", "text": "허용 범위라 그대로 가겠습니다. 대신 로그인 부하 테스트 결과를 README에 적어주세요." },
    { "id": 8,  "conv": "room:dev", "sender": "최유진", "time": "2026-10-15T11:00:00", "text": "서버 메모리가 300명 동시 접속에서 178MB, TLS 켜면 232MB로 늘었어요." },
    { "id": 9,  "conv": "room:dev", "sender": "박지훈", "time": "2026-10-15T11:05:00", "text": "500명 테스트는 언제 하나요?" },
    { "id": 10, "conv": "room:dev", "sender": "최유진", "time": "2026-10-15T11:08:00", "text": "이번 주 금요일 오후 3시에 사내 테스트 서버에서 돌리겠습니다." },
    { "id": 11, "conv": "room:dev", "sender": "김민수 팀장", "time": "2026-10-20T16:00:00", "text": "코드 리뷰 규칙 공지합니다. PR은 최소 2명 승인이 필요하고, 500줄 넘으면 쪼개 주세요." },
    { "id": 12, "conv": "room:dev", "sender": "이서연", "time": "2026-10-20T16:02:00", "text": "테스트 커버리지 80% 미만이면 머지 막아두었습니다." },
    { "id": 13, "conv": "room:dev", "sender": "박지훈", "time": "2026-10-20T16:10:00", "text": "핫픽스는 승인 1명으로 예외 인정되나요?" },
    { "id": 14, "conv": "room:dev", "sender": "김민수 팀장", "time": "2026-10-20T16:12:00", "text": "네, 장애 대응 핫픽스만 1명 승인으로 가능합니다. 사후에 리뷰 꼭 남기세요." },
    { "id": 15, "conv": "room:dev", "sender": "최유진", "time": "2026-10-22T10:00:00", "text": "스테이징 서버 주소가 바뀌었어요. 새 주소는 stg2.talk.internal 입니다." },
    { "id": 16, "conv": "room:dev", "sender": "이서연", "time": "2026-10-22T10:05:00", "text": "방화벽은 8443 포트만 열어뒀습니다." },

    { "id": 20, "conv": "room:general", "sender": "한지은 총무", "time": "2026-10-14T09:00:00", "text": "10월 30일 오후 4시에 전사 워크숍이 있습니다. 장소는 3층 대회의실입니다." },
    { "id": 21, "conv": "room:general", "sender": "한지은 총무", "time": "2026-10-14T09:10:00", "text": "참석 인원은 10월 25일까지 사번으로 회신 부탁드립니다." },
    { "id": 22, "conv": "room:general", "sender": "김민수 팀장", "time": "2026-10-14T09:20:00", "text": "워크숍 때 간식은 뭐 나오나요?" },
    { "id": 23, "conv": "room:general", "sender": "한지은 총무", "time": "2026-10-14T09:25:00", "text": "샌드위치와 커피입니다. 알레르기 있으시면 따로 알려주세요." },
    { "id": 24, "conv": "room:general", "sender": "한지은 총무", "time": "2026-10-18T13:00:00", "text": "주차 정산은 매월 말일 전까지 총무팀에 영수증을 제출하셔야 합니다." },
    { "id": 25, "conv": "room:general", "sender": "박지훈", "time": "2026-10-18T13:05:00", "text": "영수증 없으면 어떻게 하나요?" },
    { "id": 26, "conv": "room:general", "sender": "한지은 총무", "time": "2026-10-18T13:07:00", "text": "영수증이 없으면 주차 지원은 불가합니다." },
    { "id": 27, "conv": "room:general", "sender": "한지은 총무", "time": "2026-10-21T17:30:00", "text": "이번 주 금요일 정전 점검으로 서버실 출입이 오전 9시부터 12시까지 제한됩니다." },

    { "id": 30, "conv": "dm:E1001|E1002", "sender": "이서연", "time": "2026-10-16T18:00:00", "text": "팀장님, 다음 주 월요일에 연차를 쓰려고 하는데 괜찮을까요?" },
    { "id": 31, "conv": "dm:E1001|E1002", "sender": "김민수 팀장", "time": "2026-10-16T18:05:00", "text": "월요일은 팀 회의가 있어서 21일 수요일로 옮겨주면 좋겠어요." },
    { "id": 32, "conv": "dm:E1001|E1002", "sender": "이서연", "time": "2026-10-16T18:10:00", "text": "네, 21일 수요일로 신청하겠습니다." },
    { "id": 33, "conv": "dm:E1001|E1002", "sender": "이서연", "time": "2026-10-23T12:00:00", "text": "점심 같이 가실래요? 새로 생긴 칼국수집이 맛있대요." },
    { "id": 34, "conv": "dm:E1001|E1002", "sender": "김민수 팀장", "time": "2026-10-23T12:02:00", "text": "좋아요, 12시 반에 로비에서 봐요." },

    { "id": 40, "conv": "room:hr", "sender": "오세진 인사", "time": "2026-10-17T15:00:00", "text": "올해 연봉 협상 결과는 11월 5일에 개별 통보합니다." },
