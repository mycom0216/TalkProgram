<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RAG 검색 품질 평가 도구. 질문 세트(data/dataset.json)로 BM25 / 벡터 / 하이브리드를 같은 조건에서 비교하고
    Recall@k, MRR, 권한 누출 건수, "모르면 거절" 여부를 잰다. Ollama가 켜져 있어야 한다.
    실행 방법과 옵션은 Program.cs 맨 위 주석과 README 참고. (XML 주석 안에는 연속된 하이픈을 쓸 수 없어 명령어를 적지 않았다)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChatApp.Rag\ChatApp.Rag.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="data\dataset.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
